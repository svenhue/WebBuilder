{
    "name": "datamanagement",
    "version": "0.0.1",
    "type": "module",
    "main": "index.ts",
    "types": "./index.d.ts",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "scripts": {
        "build": "vite build",
        "lint": "eslint --ext .js,.ts,.vue ./",
        "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
        "test": "echo \"No test specified\" && exit 0"
    },
    "exports": {
        "./assets": {
            "require": "./assets/*",
            "import": "./assets/*"
        },
        ".": {
            "types": "./index.d.ts",
            "require": "./index.ts",
            "import": "./index.ts"
        },
        "./module.js": {
            "types": "./src/HybridApplicationDevelopmentModule.ts",
            "require": "./src/HybridApplicationDevelopmentModule.ts",
            "import": "./src/HybridApplicationDevelopmentModule.ts"
        },
        "./vitePlugin.js": {
            "types": "./src/vitePlugin.ts",
            "require": "./src/vitePlugin.ts",
            "import": "./src/vitePlugin.ts"
        },
        "./src/*": {
            "types": "./src/*",
            "require": "./src/*",
            "import": "./src/*"
        },
        "./nuxt": {
            "import": "./nuxt.js"
        }
    },
    "devDependencies": {
        "reflect-metadata": "^0.2.1",
        "sass": "^1.72.0",
        "typescript": "^4.9.5"
    },
    "dependencies": {
      
    }
}
